{
  "name": "table-to-markdown-converter",
  "displayName": "Table to Markdown",
  "version": "1.0.0",
  "publisher": "atelit",
  "description": "A lightweight and secure VS Code extension that converts tables between text and Markdown formats.",
  "icon": "logo.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/atelit/table-to-markdown-converter.git"
  },
  "homepage": "https://github.com/atelit/table-to-markdown-converter",
  "extensionKind": [
    "ui",
    "workspace"
  ],
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./extension.js",
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "table-to-markdown.toggle",
        "title": "Convert / Revert Table Format"
      }
    ],
    "keybindings": [
      {
        "command": "table-to-markdown.toggle",
        "key": "alt+shift+m",
        "mac": "alt+shift+m",
        "when": "editorHasSelection && editorTextFocus"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "when": "editorHasSelection",
          "command": "table-to-markdown.toggle",
          "group": "modification"
        }
      ]
    }
  }
}
